<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:CUETools.Linux.App.Views"
        x:Class="CUETools.Linux.App.MainWindow"
        Title="CUETools Linux"
        Width="1200" Height="720"
        MinWidth="960" MinHeight="560"
        Background="{DynamicResource Ground}">

  <!-- Shell structure mirroring the WPF MainWindow: faceplate header bar,
       grouped nav rail on the left, page host on the right. Pages arrive
       with milestone M4; the Verify placeholder marks the seam. -->
  <Panel>
  <Grid x:Name="Shell" RowDefinitions="56,*">

    <Border Grid.Row="0"
            Background="{DynamicResource Bar}"
            BorderBrush="{DynamicResource Line}"
            BorderThickness="0,0,0,1">
      <DockPanel Margin="20,0" VerticalAlignment="Center">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10"
                    VerticalAlignment="Center">
          <TextBlock Text="CUETOOLS"
                     FontFamily="{StaticResource Serif}"
                     FontSize="20" FontWeight="SemiBold"
                     Foreground="{DynamicResource Ink}"
                     VerticalAlignment="Center" />
          <TextBlock Text="LINUX"
                     FontFamily="{StaticResource Serif}"
                     FontSize="20" FontWeight="SemiBold"
                     Foreground="{DynamicResource StatusAccent}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <Button DockPanel.Dock="Right" x:Name="ThemeToggle"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Content="Light theme"
                Click="OnThemeToggleClick" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="214,*">

      <Border Grid.Column="0"
              Background="{DynamicResource Bar}"
              BorderBrush="{DynamicResource Line}"
              BorderThickness="0,0,1,0">
        <StackPanel Margin="12,16" Spacing="4">
          <TextBlock Text="WORK"
                     FontFamily="{StaticResource Mono}"
                     FontSize="11"
                     Foreground="{DynamicResource Muted}"
                     Margin="10,0,0,4" />
          <Border x:Name="RipNav"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Line}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,9"
                  Cursor="Hand"
                  PointerPressed="OnRipNavPressed">
            <StackPanel>
              <TextBlock Text="Rip"
                         FontSize="13"
                         Foreground="{DynamicResource Ink}" />
              <TextBlock Text="Secure CD ripping"
                         FontFamily="{StaticResource Mono}"
                         FontSize="10.5"
                         Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </Border>
          <Border x:Name="VerifyNav"
                  Background="{DynamicResource Face}"
                  BorderBrush="{DynamicResource StatusAccent}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,9"
                  Cursor="Hand"
                  PointerPressed="OnVerifyNavPressed">
            <StackPanel>
              <TextBlock Text="Verify &amp; Repair"
                         FontSize="13"
                         Foreground="{DynamicResource Ink}" />
              <TextBlock Text="AccurateRip + CTDB"
                         FontFamily="{StaticResource Mono}"
                         FontSize="10.5"
                         Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </Border>
          <Border x:Name="ConvertNav"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Line}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,9"
                  Cursor="Hand"
                  PointerPressed="OnConvertNavPressed">
            <StackPanel>
              <TextBlock Text="Convert"
                         FontSize="13"
                         Foreground="{DynamicResource Ink}" />
              <TextBlock Text="Re-encode existing rips"
                         FontFamily="{StaticResource Mono}"
                         FontSize="10.5"
                         Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </Border>
          <TextBlock Text="SESSION"
                     FontFamily="{StaticResource Mono}"
                     FontSize="11"
                     Foreground="{DynamicResource Muted}"
                     Margin="10,12,0,4" />
          <Border x:Name="QueueNav"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Line}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,9"
                  Cursor="Hand"
                  PointerPressed="OnQueueNavPressed">
            <StackPanel>
              <TextBlock Text="Queue"
                         FontSize="13"
                         Foreground="{DynamicResource Ink}" />
              <TextBlock Text="Batch verify or convert"
                         FontFamily="{StaticResource Mono}"
                         FontSize="10.5"
                         Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </Border>
          <Border x:Name="EnrichPendingNav"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Line}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,9"
                  Cursor="Hand"
                  IsVisible="False"
                  PointerPressed="OnEnrichPendingPressed">
            <StackPanel>
              <TextBlock x:Name="EnrichPendingTitle" Text="Enrichment pending"
                         FontSize="13"
                         Foreground="{DynamicResource Ink}" />
              <TextBlock Text="Offline lookups ready to review"
                         FontFamily="{StaticResource Mono}"
                         FontSize="10.5"
                         Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </Border>
          <Border x:Name="ReportNav"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Line}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,9"
                  Cursor="Hand"
                  PointerPressed="OnReportNavPressed">
            <StackPanel>
              <TextBlock Text="Report"
                         FontSize="13"
                         Foreground="{DynamicResource Ink}" />
              <TextBlock Text="The last job's certificate"
                         FontFamily="{StaticResource Mono}"
                         FontSize="10.5"
                         Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </Border>
          <Border x:Name="NamingNav"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Line}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,9"
                  Cursor="Hand"
                  PointerPressed="OnNamingNavPressed">
            <StackPanel>
              <TextBlock Text="Naming"
                         FontSize="13"
                         Foreground="{DynamicResource Ink}" />
              <TextBlock Text="File and folder scheme"
                         FontFamily="{StaticResource Mono}"
                         FontSize="10.5"
                         Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </Border>
          <Border x:Name="DriveNav"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Line}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,9"
                  Cursor="Hand"
                  PointerPressed="OnDriveNavPressed">
            <StackPanel>
              <TextBlock Text="Drive &amp; Read"
                         FontSize="13"
                         Foreground="{DynamicResource Ink}" />
              <TextBlock Text="What the hardware reports"
                         FontFamily="{StaticResource Mono}"
                         FontSize="10.5"
                         Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </Border>
          <Border x:Name="SettingsNav"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Line}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,9"
                  Cursor="Hand"
                  PointerPressed="OnSettingsNavPressed">
            <StackPanel>
              <TextBlock Text="Settings"
                         FontSize="13"
                         Foreground="{DynamicResource Ink}" />
              <TextBlock Text="Options, privacy, encoders"
                         FontFamily="{StaticResource Mono}"
                         FontSize="10.5"
                         Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </Border>
          <Border x:Name="AdvancedNav"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Line}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,9"
                  Cursor="Hand"
                  PointerPressed="OnAdvancedNavPressed">
            <StackPanel>
              <TextBlock Text="Advanced"
                         FontSize="13"
                         Foreground="{DynamicResource Ink}" />
              <TextBlock Text="Engine options, rarely needed"
                         FontFamily="{StaticResource Mono}"
                         FontSize="10.5"
                         Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </Border>
          <TextBlock Text="LEARN"
                     FontFamily="{StaticResource Mono}"
                     FontSize="11"
                     Foreground="{DynamicResource Muted}"
                     Margin="10,12,0,4" />
          <Border x:Name="ExploreNav"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Line}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,9"
                  Cursor="Hand"
                  PointerPressed="OnExploreNavPressed">
            <StackPanel>
              <TextBlock Text="How a CD Works"
                         FontSize="13"
                         Foreground="{DynamicResource Ink}" />
              <TextBlock Text="Zoom into the disc itself"
                         FontFamily="{StaticResource Mono}"
                         FontSize="10.5"
                         Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Grid Grid.Column="1">
        <views:VerifyView x:Name="VerifyPage" />
        <views:RipView x:Name="RipPage" IsVisible="False" />
        <views:ConvertView x:Name="ConvertPage" IsVisible="False" />
        <views:QueueView x:Name="QueuePage" IsVisible="False" />
        <views:ReportView x:Name="ReportPage" IsVisible="False" />
        <views:NamingView x:Name="NamingPage" IsVisible="False" />
        <views:DriveView x:Name="DrivePage" IsVisible="False" />
        <views:SettingsView x:Name="SettingsPage" IsVisible="False" />
        <views:AdvancedView x:Name="AdvancedPage" IsVisible="False" />
        <views:ExploreView x:Name="ExplorePage" IsVisible="False" />
      </Grid>

    </Grid>
  </Grid>

  <!-- the filament fade: holds the old theme's frame while the new one dims in -->
  <Image x:Name="ThemeFadeOverlay" IsVisible="False" IsHitTestVisible="False" Stretch="Fill" />
  </Panel>
</Window>
