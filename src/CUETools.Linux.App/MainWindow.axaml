<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CUETools.Linux.App.MainWindow"
        Title="CUETools Linux"
        Width="1200" Height="720"
        MinWidth="960" MinHeight="560"
        Background="{DynamicResource Ground}">

  <!-- Shell structure mirroring the WPF MainWindow: faceplate header bar,
       grouped nav rail on the left, page host on the right. Pages arrive
       with milestone M4; the Verify placeholder marks the seam. -->
  <Grid RowDefinitions="56,*">

    <Border Grid.Row="0"
            Background="{DynamicResource Bar}"
            BorderBrush="{DynamicResource Line}"
            BorderThickness="0,0,0,1">
      <DockPanel Margin="20,0" VerticalAlignment="Center">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10"
                    VerticalAlignment="Center">
          <TextBlock Text="CUETOOLS"
                     FontFamily="{StaticResource Serif}"
                     FontSize="20" FontWeight="SemiBold"
                     Foreground="{DynamicResource Ink}"
                     VerticalAlignment="Center" />
          <TextBlock Text="LINUX"
                     FontFamily="{StaticResource Serif}"
                     FontSize="20" FontWeight="SemiBold"
                     Foreground="{DynamicResource StatusAccent}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <Button DockPanel.Dock="Right" x:Name="ThemeToggle"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Content="Light theme"
                Click="OnThemeToggleClick" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="214,*">

      <Border Grid.Column="0"
              Background="{DynamicResource Bar}"
              BorderBrush="{DynamicResource Line}"
              BorderThickness="0,0,1,0">
        <StackPanel Margin="12,16" Spacing="4">
          <TextBlock Text="WORK"
                     FontFamily="{StaticResource Mono}"
                     FontSize="11"
                     Foreground="{DynamicResource Muted}"
                     Margin="10,0,0,4" />
          <Border Background="{DynamicResource Face}"
                  BorderBrush="{DynamicResource Line}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,9">
            <StackPanel>
              <TextBlock Text="Verify &amp; Repair"
                         FontSize="13"
                         Foreground="{DynamicResource Ink}" />
              <TextBlock Text="arrives with M4"
                         FontFamily="{StaticResource Mono}"
                         FontSize="10.5"
                         Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Padding="28,24">
        <StackPanel Spacing="10" MaxWidth="720"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
          <TextBlock Text="Scaffold shell"
                     FontFamily="{StaticResource Serif}"
                     FontSize="24"
                     Foreground="{DynamicResource Ink}" />
          <TextBlock TextWrapping="Wrap"
                     FontSize="13.5"
                     Foreground="{DynamicResource InkDim}"
                     Text="The 2026 palette, fonts, and shell structure are live with runtime dark/light switching. The Verify workspace lands here with milestone M4, wired to the shared app core extracted from the WPF build." />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Border Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="4" Padding="10,6">
              <TextBlock Text="accent" FontFamily="{StaticResource Mono}" FontSize="11"
                         Foreground="{DynamicResource StatusAccent}" />
            </Border>
            <Border Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="4" Padding="10,6">
              <TextBlock Text="good" FontFamily="{StaticResource Mono}" FontSize="11"
                         Foreground="{DynamicResource StatusGood}" />
            </Border>
            <Border Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="4" Padding="10,6">
              <TextBlock Text="warning" FontFamily="{StaticResource Mono}" FontSize="11"
                         Foreground="{DynamicResource StatusWarning}" />
            </Border>
            <Border Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="4" Padding="10,6">
              <TextBlock Text="danger" FontFamily="{StaticResource Mono}" FontSize="11"
                         Foreground="{DynamicResource StatusDanger}" />
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

    </Grid>
  </Grid>

</Window>
