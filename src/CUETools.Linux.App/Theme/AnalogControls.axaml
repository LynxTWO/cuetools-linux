<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- SLICE-014: the analog controls pass. Every button is a machined console
       key (top-lit face, edge, drop shadow, a physical depression while
       pressed); the RUN group's keys carry backlit legend strips; checkboxes
       are lamp buttons in the lit-panel language. Disabled is unpowered: the
       key stays solid, its legend and label go dark (WCAG 1.4.3 exempts
       inactive controls from contrast minimums; every ENABLED state is pinned
       by ContrastContractTests). -->

  <!-- the machined key: the default button -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource ButtonFace}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
        <!-- SLICE-015: the recess the key sits in. Invisible while the cap fills
             its own bounds; as the cap tilts and recedes under a press, this is
             the housing wall that comes into view behind it. Without it a
             receding face just reveals the page and reads as a rendering gap. -->
        <Border x:Name="keyRecess" Opacity="0" IsHitTestVisible="False"
                CornerRadius="{TemplateBinding CornerRadius}"
                Background="{DynamicResource ButtonEdge}" />
        <Border x:Name="keyFace"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="False"
                BoxShadow="0 1.5 4 0 #50000000">
          <Border.RenderTransform>
            <TranslateTransform Y="0" />
          </Border.RenderTransform>
          <Panel>
          <!-- SLICE-015: the cap is a DOMED piece of rubber, not a flat panel.
               Three layers build that shape, and they are what make a tilt read
               as a solid object rotating rather than a card shearing - the exact
               failure the WPF head hit and retreated from years ago.

               (a) crown: the bulge catching the bench light, high and centred.
               (b) shoulder: curvature falloff, so the rubber turns away and
                   darkens toward every edge instead of ending flat.
               (c) lip: a bright hairline along the top edge and a shadow along
                   the bottom, which is the cap's own thickness seen edge-on. -->
          <Border x:Name="keyShoulder" IsHitTestVisible="False"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Border.Background>
              <RadialGradientBrush GradientOrigin="50%,45%" Center="50%,45%"
                                   RadiusX="62%" RadiusY="78%">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="#00000000" Offset="0.55" />
                <GradientStop Color="{DynamicResource KeyShoulderMid}" Offset="0.88" />
                <GradientStop Color="{DynamicResource KeyShoulderEdge}" Offset="1" />
              </RadialGradientBrush>
            </Border.Background>
          </Border>
          <Border x:Name="keyCrown" IsHitTestVisible="False"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Border.Background>
              <RadialGradientBrush GradientOrigin="50%,22%" Center="50%,22%"
                                   RadiusX="58%" RadiusY="62%">
                <GradientStop Color="{DynamicResource KeyCrownCore}" Offset="0" />
                <GradientStop Color="{DynamicResource KeyCrownMid}" Offset="0.5" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
              </RadialGradientBrush>
            </Border.Background>
          </Border>
          <Border x:Name="keyLip" IsHitTestVisible="False"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BorderThickness="0,1,0,1">
            <Border.BorderBrush>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="{DynamicResource KeyLipTop}" Offset="0" />
                <GradientStop Color="{DynamicResource KeyLipBottom}" Offset="1" />
              </LinearGradientBrush>
            </Border.BorderBrush>
          </Border>
          <!-- the well's shading, clipped to the cap's own rounded shape: without
               the corner radius the gradient is cut square at the face edge
               while still dark, which draws a hard rectangle across the key. It
               sits OUTSIDE the padding so it can reach the cap's edges; inside
               it, it could only ever clip around the label. -->
          <Border x:Name="keyDip" Opacity="0" IsHitTestVisible="False"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <StackPanel Spacing="4" Margin="{TemplateBinding Padding}">
            <ContentPresenter x:Name="keyContent"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
            <!-- SLICE-015: the dip's shading, driven by the soft-body behaviour
                 when CUETOOLS_SOFTBODY=1. Transparent and inert otherwise. -->
            <!-- the backlit legend strip; transport keys reveal it -->
            <Border x:Name="legend" Height="3" MinWidth="34" CornerRadius="1.5"
                    HorizontalAlignment="Center" IsVisible="False"
                    Background="{DynamicResource StatusAccent}" Opacity="0.45"
                    ClipToBounds="False" />
          </StackPanel>
          </Panel>
        </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button /template/ Border#keyFace">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ Border#keyFace">
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
  </Style>
  <Style Selector="Button:pressed /template/ Border#keyFace">
    <Setter Property="RenderTransform" Value="translateY(1.2px)" />
    <Setter Property="Background" Value="{DynamicResource ButtonPressed}" />
    <Setter Property="BoxShadow" Value="0 0.5 1.5 0 #50000000" />
  </Style>
  <!-- A dead key is unpowered, not blanked. The legend on a console key is a
       translucent window in an opaque cap with a bulb behind it; turning the
       key off turns that bulb down to standby rather than out, so the letters
       still carry a faint light of their own and stay readable in the dark.
       The zero-offset shadow is what makes it read as light coming THROUGH the
       letters instead of grey ink sitting on them (same recipe as the lit rail
       glyphs). Foreground was the structural Line, which measured 1.2:1 on the
       key face and could not be read at all. -->
  <Style Selector="Button:disabled">
    <Setter Property="Foreground" Value="{DynamicResource KeyStandby}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#keyContent">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Effect">
      <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="5" Opacity="0.30"
                        Color="{DynamicResource KeyStandbyGlow}" />
    </Setter>
  </Style>
  <Style Selector="Button:focus-visible /template/ Border#keyFace">
    <Setter Property="BorderBrush" Value="{DynamicResource StatusAccent}" />
  </Style>

  <!-- the accent key: a machined face in the accent metal -->
  <Style Selector="Button.accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentKeyText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="{DynamicResource AccentKeyTop}" Offset="0" />
        <GradientStop Color="{DynamicResource AccentKeyBottom}" Offset="1" />
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Button.accent:disabled">
    <Setter Property="Background" Value="{DynamicResource ButtonFace}" />
    <Setter Property="Foreground" Value="{DynamicResource KeyStandby}" />
  </Style>

  <!-- transport keys: the RUN group's dark faces with backlit legends -->
  <Style Selector="Button.transport /template/ Border#legend">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Button.transport.primary /template/ Border#legend">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Effect">
      <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="8" Opacity="0.8"
                        Color="{DynamicResource StatusAccentColor}" />
    </Setter>
  </Style>
  <Style Selector="Button.transport:disabled /template/ Border#legend">
    <Setter Property="Background" Value="{DynamicResource Line}" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Effect" Value="{x:Null}" />
  </Style>

  <!-- the lamp checkbox: the lit-panel model at checkbox scale -->
  <Style Selector="CheckBox.lit">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" ClipToBounds="False">
          <Border x:Name="housing" Width="22" Height="22" CornerRadius="6"
                  BorderThickness="1" BorderBrush="#0A0F0B" ClipToBounds="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#0A0E0B" Offset="0" />
                <GradientStop Color="#131A14" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Border x:Name="lens" CornerRadius="5" Margin="1" Opacity="0">
                <Border.Background>
                  <RadialGradientBrush GradientOrigin="50%,42%" Center="50%,42%"
                                       RadiusX="70%" RadiusY="70%">
                    <GradientStop Color="{DynamicResource LampCore}" Offset="0" />
                    <GradientStop Color="{DynamicResource LampLight}" Offset="0.62" />
                    <GradientStop Color="{DynamicResource LampCapEdge}" Offset="1" />
                  </RadialGradientBrush>
                </Border.Background>
              </Border>
              <Path x:Name="tick" Data="M 5,11 L 9.5,15.5 L 17,6.5"
                    Stroke="#39433A" StrokeThickness="2.4"
                    StrokeLineCap="Round" StrokeJoin="Round" />
              <Border Width="12" Height="3" CornerRadius="2"
                      VerticalAlignment="Top" HorizontalAlignment="Center"
                      Margin="0,2.5,0,0" Background="#22FFFFFF" />
            </Grid>
          </Border>
          <ContentPresenter Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center" Margin="8,0,0,0"
                            RecognizesAccessKey="True" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox.lit /template/ Border#lens">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.34" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="CheckBox.lit:checked /template/ Border#lens">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="CheckBox.lit:checked /template/ Path#tick">
    <Setter Property="Stroke" Value="#0A2A24" />
  </Style>
  <Style Selector="CheckBox.lit:checked /template/ Border#housing">
    <Setter Property="BoxShadow" Value="0 0 10 0 #A034CFC0" />
  </Style>
  <Style Selector="CheckBox.lit:focus-visible /template/ Border#housing">
    <Setter Property="BorderBrush" Value="{DynamicResource StatusAccent}" />
  </Style>
</Styles>
