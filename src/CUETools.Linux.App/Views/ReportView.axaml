<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CUETools.Wpf.ViewModels"
             x:Class="CUETools.Linux.App.Views.ReportView"
             x:DataType="vm:ReportViewModel">
  <Grid Background="{DynamicResource Ground}">

    <!-- empty state -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                IsVisible="{Binding !HasReport}">
      <TextBlock Text="No report yet" FontFamily="{StaticResource Serif}"
                 FontSize="23" Foreground="{DynamicResource Muted}"
                 HorizontalAlignment="Center" />
      <TextBlock Text="Run a Verify or Rip on the Rip page and the accuracy certificate lands here."
                 Foreground="{DynamicResource Muted}" FontSize="12.5"
                 Margin="0,7,0,0" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- certificate -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasReport}">
      <Border MaxWidth="720" Margin="24,22" Background="{DynamicResource Panel}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1"
              CornerRadius="14" Padding="6"
              HorizontalAlignment="Center">
        <Border BorderBrush="{DynamicResource GlassLine}" BorderThickness="1"
                CornerRadius="10" Padding="30,26">
          <StackPanel>
            <!-- wax seal: amber until a database confirmed the bytes, green after -->
            <Panel Width="78" Height="78" HorizontalAlignment="Center" Margin="0,0,0,14">
              <Ellipse Fill="{DynamicResource StatusWarning}"
                       IsVisible="{Binding !Confirmed}" />
              <Ellipse Fill="{DynamicResource StatusGood}"
                       IsVisible="{Binding Confirmed}" />
              <Ellipse Width="58" Height="58" Stroke="{DynamicResource Ground}"
                       StrokeThickness="2" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Opacity="0.8" />
              <Ellipse Width="30" Height="30" Stroke="{DynamicResource Ground}"
                       StrokeThickness="2" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Opacity="0.5" />
            </Panel>

            <TextBlock Text="{Binding Headline}" FontFamily="{StaticResource Serif}"
                       FontSize="15" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Muted}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Album}" FontFamily="{StaticResource Serif}"
                       FontSize="27" Foreground="{DynamicResource Ink}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock Text="{Binding Artist}" FontSize="14"
                       Foreground="{DynamicResource Ink}" Opacity="0.85"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,3,0,0" />
            <TextBlock Text="{Binding Subhead}" FontFamily="{StaticResource Mono}"
                       FontSize="11" Foreground="{DynamicResource Muted}"
                       HorizontalAlignment="Center" Margin="0,7,0,0" />

            <!-- confidence stats -->
            <Grid ColumnDefinitions="1*,14,1*" Margin="0,20,0,0">
              <Border Grid.Column="0" Background="{DynamicResource Glass}"
                      BorderBrush="{DynamicResource GlassLine}" BorderThickness="1"
                      CornerRadius="9" Padding="16,13">
                <StackPanel>
                  <TextBlock Text="ACCURATERIP" FontSize="9.5" FontWeight="Bold"
                             Foreground="{DynamicResource Muted}" />
                  <TextBlock Text="{Binding ArText}" FontFamily="{StaticResource Serif}"
                             FontSize="19" Foreground="{DynamicResource StatusAccent}"
                             Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="{DynamicResource Glass}"
                      BorderBrush="{DynamicResource GlassLine}" BorderThickness="1"
                      CornerRadius="9" Padding="16,13">
                <StackPanel>
                  <TextBlock Text="CUETOOLS DB" FontSize="9.5" FontWeight="Bold"
                             Foreground="{DynamicResource Muted}" />
                  <TextBlock Text="{Binding CtdbText}" FontFamily="{StaticResource Serif}"
                             FontSize="19" Foreground="{DynamicResource StatusAccent}"
                             Margin="0,2,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- full rip log (selectable) -->
            <TextBlock Text="RIP LOG" FontSize="9.5" FontWeight="Bold"
                       Foreground="{DynamicResource Muted}" Margin="2,20,0,7" />
            <Border Background="{DynamicResource Glass}"
                    BorderBrush="{DynamicResource GlassLine}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12">
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                <SelectableTextBlock Text="{Binding LogBody}"
                                     Foreground="{DynamicResource Ink}"
                                     FontFamily="{StaticResource Mono}" FontSize="11.5" />
              </ScrollViewer>
            </Border>

            <!-- reproducible report checksum (not a signature) -->
            <Border Background="{DynamicResource Glass}"
                    BorderBrush="{StaticResource Teal}" BorderThickness="1"
                    CornerRadius="8" Padding="14,11" Margin="0,14,0,0">
              <StackPanel>
                <DockPanel>
                  <Ellipse DockPanel.Dock="Left" Width="12" Height="12"
                           Fill="{StaticResource Teal}" Margin="0,1,10,0"
                           VerticalAlignment="Top" />
                  <TextBlock Text="{Binding IntegrityLine}"
                             Foreground="{DynamicResource Ink}" FontSize="12"
                             TextWrapping="Wrap" />
                </DockPanel>
                <SelectableTextBlock Text="{Binding DigestFooter}"
                                     Foreground="{DynamicResource Muted}"
                                     FontFamily="{StaticResource Mono}" FontSize="10.5"
                                     TextWrapping="Wrap" Margin="22,7,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
