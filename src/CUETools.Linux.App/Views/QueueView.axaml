<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CUETools.Wpf.ViewModels"
             xmlns:model="using:CUETools.Wpf.Models"
             x:Class="CUETools.Linux.App.Views.QueueView"
             x:DataType="vm:QueueViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource Ground}">

    <!-- add bar -->
    <Border Grid.Row="0" Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
            Padding="16,11">
     <StackPanel Spacing="9">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Text="Action"
                   Foreground="{DynamicResource Muted}" FontSize="11"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Classes="window" DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                  ItemsSource="{Binding Actions}"
                  SelectedItem="{Binding SelectedAction, Mode=TwoWay}" />
        <Button DockPanel.Dock="Left" Width="220" MinWidth="140"
                VerticalAlignment="Center" Margin="8,0,0,0"
                Click="OnCodecPickerClick"
                IsEnabled="{Binding CodecPickerEnabled}"
                ToolTip.Tip="{Binding SelectedCodecTooltip}"
                AutomationProperties.Name="Choose output codec">
          <TextBlock Text="{Binding SelectedCodecLabel}"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </Button>
        <Button DockPanel.Dock="Left" Content="Add file(s)..."
                Command="{Binding AddFilesCommand}" Padding="12,6"
                Margin="14,0,0,0" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Left" Content="Add folder..."
                Command="{Binding AddFolderCommand}" Padding="12,6"
                Margin="8,0,0,0" VerticalAlignment="Center" />

        <Button DockPanel.Dock="Right" Content="Run all"
                Command="{Binding RunAllCommand}" Classes="accent"
                Padding="16,6" Margin="8,0,0,0" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" Content="Stop after item"
                Command="{Binding StopCommand}" Padding="12,6"
                Margin="8,0,0,0" VerticalAlignment="Center"
                ToolTip.Tip="Finish the item running now and keep its result, leaving the rest queued." />
        <Button DockPanel.Dock="Right" Content="Clear"
                Command="{Binding ClearCommand}" Padding="12,6"
                VerticalAlignment="Center" />
      </DockPanel>

      <!-- Where converted files go. The Queue used to ignore the Convert page's folder
           and write beside each album with nothing on screen saying so (F-14). Each item
           freezes this value as it is added, so this steers what is queued next. -->
      <DockPanel LastChildFill="True"
                 IsVisible="{Binding OutputPickerEnabled}">
        <TextBlock DockPanel.Dock="Left" Text="Output"
                   Foreground="{DynamicResource Muted}" FontSize="11"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button DockPanel.Dock="Right" Content="Default"
                Command="{Binding ClearOutputCommand}" Padding="12,6"
                Margin="8,0,0,0" VerticalAlignment="Center"
                ToolTip.Tip="Write each album's converted files to its own usual location." />
        <Button DockPanel.Dock="Right" Content="Choose..."
                Command="{Binding BrowseOutputCommand}" Padding="12,6"
                Margin="8,0,0,0" VerticalAlignment="Center" />
        <!-- Trimmed rather than clipped, with the full path in a tooltip. -->
        <TextBlock Text="{Binding OutputLabel}"
                   ToolTip.Tip="{Binding OutputLabel}"
                   VerticalAlignment="Center" FontSize="12"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </DockPanel>
     </StackPanel>
    </Border>

    <!-- queue list -->
    <Grid Grid.Row="1">
      <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                 Foreground="{DynamicResource Muted}"
                 FontFamily="{StaticResource Serif}" FontSize="18"
                 Text="Queue is empty - add album folders or .cue files above."
                 IsVisible="{Binding !Items.Count}" />

      <ScrollViewer Margin="12">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="model:QueueItem">
              <Border Background="{DynamicResource Face}"
                      BorderBrush="{DynamicResource Line}" BorderThickness="1"
                      CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
                <Grid ColumnDefinitions="3*,90,110,4*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Display}"
                             Foreground="{DynamicResource Ink}" FontSize="12.5"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Source}" />
                  <TextBlock Grid.Column="1" Text="{Binding Action}"
                             Foreground="{DynamicResource Muted}"
                             FontFamily="{StaticResource Mono}" FontSize="11" />
                  <TextBlock Grid.Column="2" Text="{Binding Status}"
                             Foreground="{DynamicResource InkDim}"
                             FontFamily="{StaticResource Mono}" FontSize="11" />
                  <TextBlock Grid.Column="3" Text="{Binding Result}"
                             Foreground="{DynamicResource Muted}" FontSize="11.5"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Result}" />
                  <!-- The view model has always had RemoveCommand; nothing bound it, so the
                       only way to drop one mistaken row was Clear and start again. Bound to
                       the page, not the row, because the command lives on the view model. -->
                  <Button Grid.Column="4" Content="Remove" Padding="9,3"
                          Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                          Command="{Binding $parent[ItemsControl].((vm:QueueViewModel)DataContext).RemoveCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Take this item out of the queue. The item running now cannot be removed." />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- progress bar -->
    <Border Grid.Row="2" Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
            Padding="16,10">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusText}"
                   Foreground="{DynamicResource InkDim}" FontSize="12"
                   TextTrimming="CharacterEllipsis" />
        <ProgressBar Height="4" Margin="0,7,0,0" Minimum="0" Maximum="1"
                     Value="{Binding Progress, Mode=OneWay}"
                     Background="{DynamicResource Glass}"
                     Foreground="{DynamicResource StatusAccent}"
                     BorderThickness="0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
