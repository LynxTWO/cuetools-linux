<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CUETools.Wpf.ViewModels"
             x:Class="CUETools.Linux.App.Views.AdvancedView"
             x:DataType="vm:AdvancedViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.sec">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="Margin" Value="2,20,0,6" />
    </Style>
    <Style Selector="TextBlock.rowlabel">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="2,9" />
    </Style>
    <Style Selector="TextBox.box">
      <Setter Property="Background" Value="{DynamicResource Glass}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassLine}" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Background="{DynamicResource Ground}" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Serif}" FontSize="26" Foreground="{DynamicResource Ink}" />
      <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,2,0,4" TextWrapping="Wrap" />

      <TextBlock Classes="sec" Text="OUTPUT EXTRAS" />
      <Border Classes="row" ToolTip.Tip="Also write a .toc file listing each track's start, length and sector range next to the rip."><DockPanel><ToggleButton DockPanel.Dock="Right" Classes="lit" IsChecked="{Binding CreateTOC}" /><TextBlock Classes="rowlabel" Text="Create TOC files" /></DockPanel></Border>
      <Border Classes="row" ToolTip.Tip="Include full per-track CTDB detail in the separate AccurateRip/CTDB report. This does not replace or alter the EAC-style rip log."><DockPanel><ToggleButton DockPanel.Dock="Right" Classes="lit" IsChecked="{Binding DetailedCTDBLog}" /><TextBlock Classes="rowlabel" Text="Detailed CTDB log" /></DockPanel></Border>
      <Border Classes="row" ToolTip.Tip="Embed CTDB (CUETools Database) confidence and repair info into the encoded files' tags when ripping."><DockPanel><ToggleButton DockPanel.Dock="Right" Classes="lit" IsChecked="{Binding WriteCTDBTagsOnEncode}" /><TextBlock Classes="rowlabel" Text="Write CTDB tags on encode" /></DockPanel></Border>
      <Border Classes="row" ToolTip.Tip="Also embed CTDB tags when verifying existing files, not just when ripping."><DockPanel><ToggleButton DockPanel.Dock="Right" Classes="lit" IsChecked="{Binding WriteCTDBTagsOnVerify}" /><TextBlock Classes="rowlabel" Text="Write CTDB tags on verify" /></DockPanel></Border>
      <Border Classes="row" ToolTip.Tip="Write MP3 tags in the newer ID3v2.4 format instead of the more widely-compatible ID3v2.3. Turn on only if your player supports it."><DockPanel><ToggleButton DockPanel.Dock="Right" Classes="lit" IsChecked="{Binding UseId3v24}" /><TextBlock Classes="rowlabel" Text="Use ID3v2.4 instead of ID3v2.3" /></DockPanel></Border>
      <Border Classes="row" ToolTip.Tip="Embed the disc's table of contents (track offsets) as a tag in the encoded files, so the file can be matched back to a specific pressing later."><DockPanel><ToggleButton DockPanel.Dock="Right" Classes="lit" IsChecked="{Binding WriteCDTOCTag}" /><TextBlock Classes="rowlabel" Text="Write CDTOC tag" /></DockPanel></Border>

      <TextBlock Classes="sec" Text="COVER ART" />
      <Border Classes="row" ToolTip.Tip="Semicolon-separated list of filenames to look for as the album cover when scanning a source folder (folder.jpg, cover.jpg, etc.). %album% is replaced with the album title."><DockPanel><TextBox DockPanel.Dock="Right" Width="300" Classes="box" Text="{Binding CoverArtFiles}" /><TextBlock Classes="rowlabel" Text="Cover art file names" /></DockPanel></Border>
      <Border Classes="row" ToolTip.Tip="Also look in subfolders when searching for a local cover art file, not just the album's own folder."><DockPanel><ToggleButton DockPanel.Dock="Right" Classes="lit" IsChecked="{Binding CoverArtSearchSubdirs}" /><TextBlock Classes="rowlabel" Text="Search subfolders for cover art" /></DockPanel></Border>
      <Border Classes="row" ToolTip.Tip="How hard to search CTDB for album art: None (never fetch), Primary (front cover only), Extensive (every available image)."><DockPanel><ComboBox DockPanel.Dock="Right" Width="140" ItemsSource="{Binding CoversSearches}" SelectedItem="{Binding CoversSearch, Mode=TwoWay}" /><TextBlock Classes="rowlabel" Text="Album art search" /></DockPanel></Border>

      <TextBlock Classes="sec" Text="METADATA" />
      <Border Classes="row" ToolTip.Tip="How thoroughly to search CTDB for album and track metadata when identifying a disc: None (skip), Fast (quick match only), Default (normal), Extensive (try harder, slower)."><DockPanel><ComboBox DockPanel.Dock="Right" Width="140" ItemsSource="{Binding MetadataSearches}" SelectedItem="{Binding MetadataSearch, Mode=TwoWay}" /><TextBlock Classes="rowlabel" Text="Metadata search" /></DockPanel></Border>
      <Border Classes="row" ToolTip.Tip="Keep a local cache of fetched metadata so repeat lookups for the same disc do not need the network."><DockPanel><ToggleButton DockPanel.Dock="Right" Classes="lit" IsChecked="{Binding CacheMetadata}" /><TextBlock Classes="rowlabel" Text="Cache metadata" /></DockPanel></Border>
      <Border Classes="row" ToolTip.Tip="Hostname of the CUETools Database server to query for disc metadata, album art and verification data."><DockPanel><TextBox DockPanel.Dock="Right" Width="260" Classes="box" Text="{Binding CTDBServer}" /><TextBlock Classes="rowlabel" Text="CTDB server" /></DockPanel></Border>

      <TextBlock Classes="sec" Text="NETWORK" />
      <Border Classes="row" ToolTip.Tip="How outgoing lookups (CTDB, FreeDB/gnudb) reach the network: None (direct connection), System (use the system-configured proxy), or Custom (use the proxy settings below)."><DockPanel><ComboBox DockPanel.Dock="Right" Width="140" ItemsSource="{Binding ProxyModes}" SelectedItem="{Binding ProxyMode, Mode=TwoWay}" /><TextBlock Classes="rowlabel" Text="Proxy mode" /></DockPanel></Border>
      <Border Classes="row" ToolTip.Tip="Custom proxy server hostname or IP address. Used only when Proxy mode is set to Custom."><DockPanel><TextBox DockPanel.Dock="Right" Width="200" Classes="box" Text="{Binding ProxyServer}" /><TextBlock Classes="rowlabel" Text="Proxy server" /></DockPanel></Border>
      <Border Classes="row" ToolTip.Tip="Custom proxy server port. Used only when Proxy mode is set to Custom."><DockPanel><TextBox DockPanel.Dock="Right" Width="90" Classes="box" Text="{Binding ProxyPort}" /><TextBlock Classes="rowlabel" Text="Proxy port" /></DockPanel></Border>
      <Border Classes="row" ToolTip.Tip="Username for the custom proxy, if it requires authentication."><DockPanel><TextBox DockPanel.Dock="Right" Width="200" Classes="box" Text="{Binding ProxyUser}" /><TextBlock Classes="rowlabel" Text="Proxy user" /></DockPanel></Border>
      <Border Classes="row" ToolTip.Tip="The proxy credential is protected for this user account. The saved value is never displayed; enter a replacement or clear it explicitly.">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="{Binding ProxyPasswordStatus}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="ProxyPasswordInput" Width="150" Classes="box" PasswordChar="*" ToolTip.Tip="New proxy password" />
            <Button Content="Set" Padding="10,3" Margin="6,0,0,0" Click="OnSetProxyPassword" />
            <Button Content="Clear" Padding="10,3" Margin="6,0,0,0" Click="OnClearProxyPassword" />
          </StackPanel>
          <TextBlock Classes="rowlabel" Text="Proxy password" />
        </DockPanel>
      </Border>
      <Border Classes="row" ToolTip.Tip="The 'user' part of the email address sent to the FreeDB/gnudb metadata server when looking up disc info. Most servers accept any value here."><DockPanel><TextBox DockPanel.Dock="Right" Width="200" Classes="box" Text="{Binding FreedbUser}" /><TextBlock Classes="rowlabel" Text="Freedb email user" /></DockPanel></Border>
      <Border Classes="row" ToolTip.Tip="The domain part of the email address sent to the FreeDB/gnudb metadata server when looking up disc info."><DockPanel><TextBox DockPanel.Dock="Right" Width="200" Classes="box" Text="{Binding FreedbDomain}" /><TextBlock Classes="rowlabel" Text="Freedb email domain" /></DockPanel></Border>
      <Border Classes="row" ToolTip.Tip="Hostname of the FreeDB/gnudb-compatible server used for legacy disc metadata lookups."><DockPanel><TextBox DockPanel.Dock="Right" Width="260" Classes="box" Text="{Binding FreedbSiteAddress}" /><TextBlock Classes="rowlabel" Text="Freedb site address" /></DockPanel></Border>

      <TextBlock Margin="2,22,0,0" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                 Text="Changes apply immediately and are saved when the app closes." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
